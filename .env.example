# Copy this file to .env and fill in your values
# cp .env.example .env

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
PRETTY_JSON=false

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: matches docker-compose.yml defaults
DATABASE_URL=postgresql://pathfinder:pathfinder@localhost:5432/pathfinder

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ── ElevenLabs (optional, for TTS) ────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── AI pipeline ───────────────────────────────────────────────────────────────
MAX_RETRIES=1
RETRY_MIN_SCORE=3

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
GENERATE_LIMIT_PER_HOUR=10

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
